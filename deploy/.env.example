# Copy to deploy/.env and fill in. deploy.sh reads it locally and copies it to the
# server. deploy/.env is git-ignored: keep real names and logins there, never here.
DOMAIN=game.example.com

# Login for the site (Traefik basic auth). Set it with: deploy/deploy.sh password <user>
# (it asks for the password and stores only a bcrypt hash here).
BASIC_AUTH_USERS=

# Where deploy.sh ships to: SSH login for the server (user@host or a ~/.ssh/config
# alias), and the folder there (relative to its home).
DEPLOY_HOST=user@your-server
DEPLOY_DIR=dinoworld
